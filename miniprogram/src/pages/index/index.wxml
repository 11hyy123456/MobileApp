<!-- 首页 -->
<!-- 功能说明：展示学习统计数据、快捷操作入口、最近笔记预览 -->

<view class="container">
  <view class="header">
    <view class="greeting">
      <text class="title">{{isLoggedIn ? '欢迎回来' : '学习笔记'}}</text>
      <text class="subtitle">{{isLoggedIn ? userInfo.username : '登录后开启学习之旅'}}</text>
    </view>
    <view class="avatar" bindtap="goToProfile">
      <image src="{{userInfo.avatar || '/assets/icons/profile.png'}}" mode="aspectFill"/>
    </view>
  </view>

  <view class="stats" wx:if="{{isLoggedIn}}">
    <view class="stat-item" bindtap="goToNotes">
      <text class="stat-value">{{stats.noteCount}}</text>
      <text class="stat-label">笔记总数</text>
    </view>
    <view class="stat-item" bindtap="goToReview">
      <text class="stat-value">{{stats.dueReviewCount}}</text>
      <text class="stat-label">待复习</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.categoryCount}}</text>
      <text class="stat-label">分类</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.reviewStreak}}</text>
      <text class="stat-label">连续天数</text>
    </view>
  </view>

  <view class="quick-actions" wx:if="{{isLoggedIn}}">
    <view class="section-title">快捷操作</view>
    <view class="action-grid">
      <view class="action-item" bindtap="goToNewNote">
        <view class="action-icon" style="background-color: #1989fa;">
          <text class="icon">+</text>
        </view>
        <text class="action-text">新建笔记</text>
      </view>
      <view class="action-item" bindtap="goToSearch">
        <view class="action-icon" style="background-color: #07c160;">
          <text class="icon">🔍</text>
        </view>
        <text class="action-text">搜索笔记</text>
      </view>
      <view class="action-item" bindtap="goToReview">
        <view class="action-icon" style="background-color: #ff976a;">
          <text class="icon">📖</text>
        </view>
        <text class="action-text">开始复习</text>
      </view>
      <view class="action-item" bindtap="goToCategories">
        <view class="action-icon" style="background-color: #ed6a0c;">
          <text class="icon">📁</text>
        </view>
        <text class="action-text">分类管理</text>
      </view>
    </view>
  </view>

  <view class="recent-notes" wx:if="{{isLoggedIn && recentNotes.length > 0}}">
    <view class="section-header">
      <text class="section-title">最近笔记</text>
      <text class="more" bindtap="goToNotes">查看全部</text>
    </view>
    <view class="note-list">
      <view class="note-card" wx:for="{{recentNotes}}" wx:key="id" bindtap="goToNoteDetail" data-id="{{item.id}}">
        <view class="note-header">
          <text class="note-title">{{item.title}}</text>
          <view class="note-tag" wx:if="{{item.category}}" style="background-color: {{item.category.color}}">{{item.category.name}}</view>
        </view>
        <text class="note-summary">{{item.summary || '暂无摘要'}}</text>
        <view class="note-footer">
          <text class="note-date">{{item.formattedDate}}</text>
          <view class="note-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="id">{{tag.name}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="login-prompt" wx:if="{{!isLoggedIn}}">
    <view class="prompt-content">
      <text class="prompt-icon">📚</text>
      <text class="prompt-title">开启你的学习之旅</text>
      <text class="prompt-desc">记录学习笔记，管理知识资产，让学习更高效</text>
      <button class="login-btn" bindtap="goToLogin">登录 / 注册</button>
    </view>
  </view>
</view>
