<!-- 标签管理页面 -->
<view class="container">
  <view class="header">
    <text class="title">标签管理</text>
  </view>

  <view class="tag-list">
    <view class="tag-card" wx:for="{{tags}}" wx:key="id">
      <view class="tag-info">
        <view class="tag-dot" style="background-color: {{item.color || '#07c160'}}"></view>
        <text class="tag-name">{{item.name}}</text>
        <text class="tag-count">{{item.noteCount || 0}} 篇</text>
      </view>
      <view class="action-btn delete" bindtap="deleteTag" data-id="{{item.id}}">🗑️</view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{tags.length === 0}}">
    <text class="empty-icon">🏷️</text>
    <text class="empty-text">还没有标签</text>
  </view>

  <view class="add-section">
    <button class="add-btn" bindtap="showAddTag">+ 新建标签</button>
  </view>
</view>
