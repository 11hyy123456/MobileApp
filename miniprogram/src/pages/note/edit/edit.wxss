.container {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #eee;
}

.toolbar-left,
.toolbar-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tool-btn {
  padding: 12rpx 20rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #ddd;
}

.tool-btn.active {
  background: #1989fa;
  color: #fff;
  border-color: #1989fa;
}

.form-section {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}

.title-input {
  width: 100%;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  padding: 16rpx 0;
  border: none;
  outline: none;
}

.title-input::placeholder {
  color: #ccc;
}

.section-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-chips {
  display: inline-flex;
  gap: 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  white-space: nowrap;
}

.chip.active {
  background: #1989fa;
  color: #fff;
}

.tags-section {
  margin-top: 24rpx;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  padding: 8rpx 20rpx;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #07c160;
}

.tag-chip.active {
  background: #07c160;
  color: #fff;
}

.tag-chip.add-tag {
  background: #f5f5f5;
  color: #999;
}

.editor-section {
  flex: 1;
  min-height: 400rpx;
}

.editor {
  width: 100%;
  min-height: 400rpx;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  font-family: monospace;
  box-sizing: border-box;
}

.editor.hidden {
  display: none;
}

.preview {
  padding: 24rpx 32rpx;
  min-height: 400rpx;
  font-size: 30rpx;
  line-height: 1.8;
}

.preview.hidden {
  display: none;
}

.bottom-bar {
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #1989fa;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
