<!-- 标签管理页面 -->
<!-- 功能说明：管理笔记标签，支持创建、删除标签 -->

<view class="container">
  <view class="header">
    <text class="title">标签管理</text>
    <text class="subtitle">使用标签更好地组织笔记</text>
  </view>

  <view class="tag-list">
    <view class="tag-card" wx:for="{{tags}}" wx:key="id">
      <view class="tag-info">
        <view class="tag-dot" style="background-color: {{item.color || '#07c160'}}"></view>
        <text class="tag-name">{{item.name}}</text>
        <text class="tag-count">{{item.noteCount || 0}} 篇</text>
      </view>
      <view class="tag-actions">
        <view class="action-btn delete" bindtap="deleteTag" data-id="{{item.id}}">
          <text>🗑️</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{tags.length === 0}}">
    <text class="empty-icon">🏷️</text>
    <text class="empty-text">还没有标签</text>
    <text class="empty-hint">为笔记添加标签方便分类和查找</text>
  </view>

  <view class="add-section">
    <button class="add-btn" bindtap="showAddTag">
      <text class="add-icon">+</text>
      <text>新建标签</text>
    </button>
  </view>
</view>
