<!-- 笔记编辑页面 -->
<!-- 功能说明：创建和编辑笔记，支持Markdown编辑、分类选择、标签选择，实时预览 -->

<view class="container">
  <view class="toolbar">
    <view class="toolbar-left">
      <view class="tool-btn {{mode === 'edit' ? 'active' : ''}}" bindtap="switchMode" data-mode="edit">
        <text>编辑</text>
      </view>
      <view class="tool-btn {{mode === 'preview' ? 'active' : ''}}" bindtap="switchMode" data-mode="preview">
        <text>预览</text>
      </view>
      <view class="tool-btn {{mode === 'split' ? 'active' : ''}}" bindtap="switchMode" data-mode="split">
        <text>分屏</text>
      </view>
    </view>
    <view class="toolbar-right">
      <view class="tool-btn" bindtap="insertMarkdown" data-type="bold">
        <text>B</text>
      </view>
      <view class="tool-btn" bindtap="insertMarkdown" data-type="italic">
        <text>I</text>
      </view>
      <view class="tool-btn" bindtap="insertMarkdown" data-type="code">
        <text>&lt;/&gt;</text>
      </view>
      <view class="tool-btn" bindtap="insertMarkdown" data-type="list">
        <text>•</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <input class="title-input" placeholder="输入笔记标题..." value="{{title}}" bindinput="onTitleInput" />

    <view class="category-tag-section">
      <view class="section-label">分类</view>
      <scroll-view class="category-scroll" scroll-x="true">
        <view class="category-chips">
          <view class="chip {{selectedCategoryId === 0 ? 'active' : ''}}" bindtap="selectCategory" data-id="0">无</view>
          <view class="chip {{selectedCategoryId === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="selectCategory" data-id="{{item.id}}" style="border-color: {{item.color}}">
            {{item.name}}
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="tags-section">
      <view class="section-label">标签</view>
      <view class="tags-wrap">
        <view class="tag-chip {{selectedTagIds.includes(item.id) ? 'active' : ''}}" wx:for="{{allTags}}" wx:key="id" bindtap="toggleTag" data-id="{{item.id}}">
          {{item.name}}
        </view>
        <view class="tag-chip add-tag" bindtap="showAddTag">
          <text>+</text>
        </view>
      </view>
    </view>
  </view>

  <view class="editor-section">
    <textarea class="editor {{mode === 'preview' ? 'hidden' : ''}}" placeholder="使用Markdown编写笔记内容..." value="{{content}}" bindinput="onContentInput" bindblur="onContentBlur" />
    <view class="preview {{mode === 'edit' ? 'hidden' : ''}}">
      <rich-text nodes="{{htmlContent}}"></rich-text>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="save-btn" bindtap="saveNote" loading="{{saving}}">保存笔记</button>
  </view>
</view>
