.container { min-height: 100vh; background: #f5f5f5; }
.header { background: #ff976a; padding: 48rpx 32rpx; color: #fff; }
.title { display: block; font-size: 44rpx; font-weight: 600; margin-bottom: 8rpx; }
.subtitle { font-size: 28rpx; opacity: 0.9; }
.trash-list { padding: 24rpx 32rpx; }
.trash-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05); }
.card-content { margin-bottom: 24rpx; }
.note-title { display: block; font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.note-date { font-size: 24rpx; color: #999; }
.card-actions { display: flex; gap: 20rpx; }
.action-btn { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; }
.action-btn.recover { background: rgba(7, 193, 96, 0.1); color: #07c160; }
.action-btn.delete { background: rgba(255, 77, 79, 0.1); color: #ff4d4f; }
.action-text { font-size: 26rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 120rpx; margin-bottom: 32rpx; }
.empty-text { font-size: 32rpx; color: #333; font-weight: 500; }
