.container {
  min-height: 100vh;
  background: #f5f7fb;
  width: 100%;
  padding-top: 0;
}

.profile-header {
  background: linear-gradient(135deg, #1989fa 0%, #07c160 100%);
  padding: 48rpx 20rpx 80rpx;
  width: 100%;
  box-sizing: border-box;
}

.avatar-section {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #fff;
  overflow: hidden;
  margin-right: 24rpx;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.user-sign {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.stats-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 0;
  margin: -40rpx 0 0;
  box-sizing: border-box;
}

.stat-card {
  background: #fff;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #1989fa;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.menu-section {
  width: 100%;
  padding: 0;
  margin: 32rpx 0;
  background: #fff;
  box-sizing: border-box;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.logout-section {
  width: 100%;
  padding: 0;
  box-sizing: border-box;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #fff;
  color: #ff4d4f;
  border-radius: 0;
  font-size: 32rpx;
  border: none;
}