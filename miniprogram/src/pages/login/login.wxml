<!-- 登录页面 -->
<!-- 功能说明：用户输入用户名和密码进行登录，使用JWT Token认证 -->

<view class="container">
  <view class="header-section">
    <text class="logo">📚</text>
    <text class="title">学习笔记</text>
    <text class="subtitle">登录到你的账户</text>
  </view>

  <view class="form-section">
    <view class="form-item">
      <text class="label">用户名</text>
      <input class="input" type="text" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />
    </view>

    <view class="form-item">
      <text class="label">密码</text>
      <input class="input" type="password" placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <button class="login-btn" bindtap="handleLogin" loading="{{loading}}">登录</button>

    <view class="footer-section">
      <text class="register-link" bindtap="goToRegister">还没有账户？立即注册</text>
    </view>
  </view>
</view>
