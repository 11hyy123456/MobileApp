<view class="container">
  <view class="profile-header">
    <view class="avatar-section">
      <view class="avatar">
        <image src="{{userInfo.avatar || '/assets/icons/profile.png'}}" mode="aspectFill" />
      </view>
      <view class="user-info">
        <text class="username">{{userInfo.username || '用户'}}</text>
        <text class="user-sign">学无止境，温故知新</text>
      </view>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-value">{{stats.noteCount || 0}}</text>
      <text class="stat-label">笔记</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.categoryCount || 0}}</text>
      <text class="stat-label">分类</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.reviewCount || 0}}</text>
      <text class="stat-label">复习次数</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.streak || 0}}</text>
      <text class="stat-label">连续天数</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="section-title">通用功能</view>
    <view class="menu-item" bindtap="goToCategories">
      <view class="menu-icon-wrapper" style="background: #e8f4ff;">
        <text class="menu-icon">📁</text>
      </view>
      <text class="menu-text">分类管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToTags">
      <view class="menu-icon-wrapper" style="background: #fff0e8;">
        <text class="menu-icon">🏷️</text>
      </view>
      <text class="menu-text">标签管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToTrash">
      <view class="menu-icon-wrapper" style="background: #fce8e6;">
        <text class="menu-icon">🗑️</text>
      </view>
      <text class="menu-text">回收站</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-section">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view>