.container {
  min-height: 100vh;
  background: #fff;
  padding-bottom: 120rpx;
}

.header {
  padding: 32rpx;
  border-bottom: 1rpx solid #eee;
}

.header-top {
  margin-bottom: 16rpx;
}

.category-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #fff;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.date,
.views {
  font-size: 26rpx;
  color: #999;
}

.content {
  padding: 32rpx;
}

.markdown-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}

.markdown-content h1 {
  font-size: 40rpx;
  font-weight: 600;
  margin: 32rpx 0 16rpx;
}

.markdown-content h2 {
  font-size: 36rpx;
  font-weight: 600;
  margin: 28rpx 0 14rpx;
}

.markdown-content h3 {
  font-size: 32rpx;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
}

.markdown-content code {
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-family: monospace;
}

.markdown-content li {
  margin: 12rpx 0;
  padding-left: 20rpx;
}

.tags-section {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #eee;
}

.tags-title {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.review-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #f5f7ff;
  margin: 24rpx 32rpx;
  border-radius: 16rpx;
}

.review-info {
  display: flex;
  flex-direction: column;
}

.review-label {
  font-size: 24rpx;
  color: #666;
}

.review-date {
  font-size: 32rpx;
  color: #1989fa;
  font-weight: 600;
  margin-top: 8rpx;
}

.review-btn {
  padding: 16rpx 32rpx;
  background: #1989fa;
  color: #fff;
  border-radius: 32rpx;
  font-size: 28rpx;
  border: none;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 40rpx;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 28rpx;
  color: #999;
}
