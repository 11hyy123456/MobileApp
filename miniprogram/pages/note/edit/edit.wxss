.container {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.form-section {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}

.title-input {
  width: 100%;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  padding: 16rpx 0;
  border: none;
  outline: none;
}

.title-input::placeholder {
  color: #ccc;
}

.section-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.category-scroll {
  white-space: nowrap;
}

.category-chips {
  display: inline-flex;
  gap: 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.chip.active {
  background: #1989fa;
  color: #fff;
}

.editor-section {
  flex: 1;
  min-height: 400rpx;
}

.editor {
  width: 100%;
  min-height: 500rpx;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  box-sizing: border-box;
}

.bottom-bar {
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #1989fa;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
