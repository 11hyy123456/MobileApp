<!-- 笔记详情页面 -->
<!-- 功能说明：展示笔记完整内容，支持Markdown渲染，提供编辑、删除、复习功能 -->

<view class="container" wx:if="{{note}}">
  <view class="header">
    <view class="header-top">
      <text class="category-tag" wx:if="{{note.category}}" style="background-color: {{note.category.color}}">
        {{note.category.name}}
      </text>
    </view>
    <text class="title">{{note.title}}</text>
    <view class="meta">
      <text class="date">{{note.formattedDate}}</text>
      <text class="views">浏览 {{note.reviewCount || 0}} 次</text>
    </view>
  </view>

  <view class="content">
    <rich-text nodes="{{note.htmlContent}}" class="markdown-content"></rich-text>
  </view>

  <view class="tags-section" wx:if="{{note.tags && note.tags.length > 0}}">
    <text class="tags-title">标签</text>
    <view class="tags-list">
      <text class="tag" wx:for="{{note.tags}}" wx:key="id">{{item.name}}</text>
    </view>
  </view>

  <view class="review-section" wx:if="{{note.nextReviewAt}}">
    <view class="review-info">
      <text class="review-label">下次复习</text>
      <text class="review-date">{{note.relativeReviewDate}}</text>
    </view>
    <button class="review-btn" bindtap="startReview">立即复习</button>
  </view>

  <view class="action-bar">
    <view class="action-item" bindtap="goToEdit">
      <text class="action-icon">✏️</text>
      <text class="action-text">编辑</text>
    </view>
    <view class="action-item" bindtap="shareNote">
      <text class="action-icon">📤</text>
      <text class="action-text">分享</text>
    </view>
    <view class="action-item" bindtap="toggleStar">
      <text class="action-icon">{{note.isStarred ? '⭐' : '☆'}}</text>
      <text class="action-text">{{note.isStarred ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="action-item" bindtap="deleteNote">
      <text class="action-icon">🗑️</text>
      <text class="action-text">删除</text>
    </view>
  </view>
</view>

<view class="loading-state" wx:if="{{!note && loading}}">
  <text>加载中...</text>
</view>
