.container {
  min-height: 100vh;
  background: #fff;
  padding-bottom: 120rpx;
}

.form-section {
  padding: 24rpx 32rpx;
  border-bottom: none;  /* 移除边框，让视觉更连贯 */
  background: #fff;
}

.title-input {
  width: 100%;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  padding: 16rpx 0;
  border: none;
  outline: none;
}

.title-input::placeholder {
  color: #ccc;
}

.section-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.category-scroll {
  white-space: nowrap;
}

.category-chips {
  display: inline-flex;
  gap: 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.chip.active {
  background: #1989fa;
  color: #fff;
}

.editor-section {
  flex: 1;
  width: 100%;
  margin-top: 0;  /* 移除负边距，让它紧贴上面 */
  padding: 0;     /* 移除内边距 */
}

.editor {
  width: 100%;
  min-height: 600rpx;
  padding: 24rpx 32rpx;  /* 保持和 form-section 一样的内边距 */
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  box-sizing: border-box;
  border: none;
  background: #f8f9fa;
  margin: 0;  /* 确保没有外边距 */
}

.bottom-bar {
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #1989fa;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}