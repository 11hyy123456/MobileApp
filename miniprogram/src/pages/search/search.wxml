<!-- 搜索页面 -->
<!-- 功能说明：全站搜索笔记，支持关键词高亮，显示搜索历史 -->

<view class="container">
  <view class="search-header">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索笔记标题或内容..." value="{{keyword}}" bindinput="onSearchInput" focus="true" />
      <text class="clear-btn" wx:if="{{keyword}}" bindtap="clearSearch">✕</text>
    </view>
    <text class="cancel-btn" bindtap="goBack">取消</text>
  </view>

  <view class="history-section" wx:if="{{!keyword && history.length > 0}}">
    <view class="section-header">
      <text class="section-title">搜索历史</text>
      <text class="clear-history" bindtap="clearHistory">清除</text>
    </view>
    <view class="history-list">
      <view class="history-item" wx:for="{{history}}" wx:key="index" bindtap="useHistory" data-keyword="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <view class="results-section" wx:if="{{keyword && results.length > 0}}">
    <text class="results-count">找到 {{total}} 条结果</text>
    <view class="result-list">
      <view class="result-card" wx:for="{{results}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="result-header">
          <text class="result-title">{{item.title}}</text>
          <view class="category-tag" wx:if="{{item.category}}" style="background-color: {{item.category.color}}">
            {{item.category.name}}
          </view>
        </view>
        <text class="result-excerpt">{{item.highlightedContent || item.summary}}</text>
        <view class="result-footer">
          <text class="result-date">{{item.formattedDate}}</text>
          <view class="result-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="id">{{tag.name}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-results" wx:if="{{keyword && results.length === 0 && !loading}}">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">未找到相关笔记</text>
    <text class="empty-hint">换个关键词试试</text>
  </view>
</view>
