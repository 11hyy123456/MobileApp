<!-- 注册页面 -->
<!-- 功能说明：新用户注册账号，支持用户名、密码注册 -->

<view class="container">
  <view class="header-section">
    <text class="logo">📚</text>
    <text class="title">创建账户</text>
    <text class="subtitle">开始你的学习之旅</text>
  </view>

  <view class="form-section">
    <view class="form-item">
      <text class="label">用户名</text>
      <input class="input" type="text" placeholder="3-20位字母或数字" value="{{username}}" bindinput="onUsernameInput" />
    </view>

    <view class="form-item">
      <text class="label">手机号（可选）</text>
      <input class="input" type="number" placeholder="用于找回密码" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="form-item">
      <text class="label">密码</text>
      <input class="input" type="password" placeholder="至少6位" value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <view class="form-item">
      <text class="label">确认密码</text>
      <input class="input" type="password" placeholder="再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
    </view>

    <button class="register-btn" bindtap="handleRegister" loading="{{loading}}">注册</button>

    <view class="footer-section">
      <text class="login-link" bindtap="goToLogin">已有账户？立即登录</text>
    </view>
  </view>
</view>
