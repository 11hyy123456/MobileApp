<!-- 复习页面 -->
<!-- 功能说明：展示需要复习的笔记，基于艾宾浩斯遗忘曲线 -->

<view class="container">
  <view class="header">
    <text class="title">复习计划</text>
    <text class="subtitle">根据遗忘曲线，科学安排复习</text>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{dueCount}}</text>
      <text class="stat-label">待复习</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{reviewedToday}}</text>
      <text class="stat-label">今日已复习</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{streak}}</text>
      <text class="stat-label">连续天数</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">待复习笔记 ({{dueNotes.length}})</text>

    <view class="review-list" wx:if="{{dueNotes.length > 0}}">
      <view class="review-card" wx:for="{{dueNotes}}" wx:key="id" bindtap="goToNote" data-id="{{item.id}}">
        <view class="review-header">
          <text class="note-title">{{item.title}}</text>
          <text class="due-badge">待复习</text>
        </view>
        <text class="due-date">到期: {{item.formattedDueDate}}</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{dueNotes.length === 0}}">
      <text class="empty-icon">🎉</text>
      <text class="empty-text">太棒了！没有待复习的笔记</text>
    </view>
  </view>
</view>
